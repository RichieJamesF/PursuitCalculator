{
  "name": "pursuit-server",
  "version": "1.0.0",
  "description": "The Pursuit — cycling handicap start-sheet calculator with Strava refinement",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/unit/*.test.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "test:all": "npm test && npm run test:integration"
  },
  "engines": {
    "node": ">=18.2"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "embedded-postgres": "17.10.0-beta.17"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@17.10.0-beta.17": true
  }
}
